ode: 404, message: 'Not Found' } })` → object format\\n- Line 37: `assert.equal(body.error.code, 404)` → object format\\n- Line 45: `assert.ok(typeof body.error === 'object')` → object format\\n\\n\\n- Lines 46-47: checking that error.code is a number and error.message is a string → object format\\n\\n**`users.test.js`** (users routes):\\n- Lines 153, 164, 174, 189: expecting string error messages for various PUT failures (user not found, invalid JSON, invalid email) instead of the nested object structure\\n- Lines 120, 97: GET and POST also expect string errors for 404 and invalid JSON\\n- Line 212: just checking for truthy error on DELETE 404\\n\\nSo there's a mismatch: `index.js` needs to return `{ error: { code, message } }` for unknown routes, but `users.js` needs to return `{ error: 'string' }` for all user-related endpoints. I need to keep the errors.js format as-is for index.js and modify the users.js routes to send plain string errors instead.\\n\\nNow I'm removing the `sendError` import from users.js and replacing all error responses with a local `err` function that returns the string format.\",\"signature\":\"\"}],\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":1,\"cache_creation_input_tokens\":2190,\"cache_read_input_tokens\":63807,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":2190},\"output_tokens\":8,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"b49b3972-1e2e-43b3-9289-f553f0fe9cf8\",\"uuid\":\"a3a0932a-0ec2-465a-98ec-263a600e2e5b\"}\n{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-4-6\",\"id\":\"msg_01Y9PrwYAZ2G7ZxViCbEJphD\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Now it's clear: `index.js` needs object format `{ error: { code, message } }`, while `users.js` needs string format `{ error: 'string' }` everywhere. Let 